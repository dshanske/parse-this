{
   "name": "dshanske/parse-this",
     "description": "Parse This Library for WordPress",
     "type": "wordpress-plugin",
     "license": "GPL-2.0-or-later",
     "authors": [
       {
	       "name": "David Shanske",
	       "email": "david@shanske.com"
       }
     ],
     "support": {
 		"issues": "https://github.com/dshanske/parse-this/issues",
		"source": "https://github.com/dshanske/parse-this"
    },
    "config": {
    	"allow-plugins": {
        	"composer/installers": true,
	        "dealerdirect/phpcodesniffer-composer-installer": true
    	}
    },
     "extra": {
		"installer-name": "parse-this"
     },
    "require": {
	"php": ">=7.4",
	"composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "masterminds/html5": "^2.11",
        "mf2/mf2": "^0.5.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpcompatibility/phpcompatibility-wp": "^2.1.8",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4",
        "wpreadme2markdown/wp2md": "^4.1",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "prefer-stable" : true,
    "scripts": {
        "phpunit": "phpunit",
	"lint:wpcs": "./vendor/bin/phpcs",
	"lint:wpcs-fix": "./vendor/bin/phpcbf",
	"lint": "./vendor/bin/phpcs -n -q",
	"lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor --exclude node_modules --exclude lib .",
	"setup-local-tests": "bash bin/install-wp-tests.sh wordpress_test root root 127.0.0.1 latest",
	"install-codestandards": [
		"Dealerdirect\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin::run"
	],
	"update-readme": [
		"./vendor/wpreadme2markdown/wp2md/bin/wp2md -i readme.txt | tail -n +11 > readme.md"
	],
	"copy-files": [
		"cp vendor/mf2/mf2/Mf2/Parser.php lib/mf2",
		"cp vendor/mf2/mf2/*.md lib/mf2",
		"cp vendor/masterminds/html5/src/HTML5.php lib/html5",
		"cp vendor/masterminds/html5/*.md lib/html5",
		"cp vendor/masterminds/html5/LICENSE.txt vendor/masterminds/html5/CREDITS lib/html5",
		"rm -rf lib/html5/HTML5",
		"cp -r vendor/masterminds/html5/src/HTML5 lib/html5"

	],
	"post-update-cmd": [
		"@update-readme",
		"@copy-files"
	]
    }
}
